# Green Cheese — regras só desta pasta (public_html/greencheese/, que é a raiz de https://greencheese.oprojeto.online/
# desde 11/10 e continua respondendo, só pra redirecionar, em oprojeto.online/greencheese/).
# A raiz do domínio tem uma CSP estrita (connect-src só o próprio domínio) que bloquearia a detecção de
# estado por IP e a busca de CEP. Aqui ela é substituída por uma própria, igualmente fechada, que libera
# só os serviços que o site usa. Os links do WhatsApp e do Instagram são navegação, não entram na CSP.
Options -Indexes -MultiViews
DirectoryIndex index.html

# A loja mora em https://greencheese.oprojeto.online/ (11/10): o painel e as contas não dividem mais o endereço com o
# outro site do oprojeto.online. Quem chega pelo endereço antigo (link, favorito, QR) vai pro mesmo lugar no novo, com o
# resto do link; o que não é GET/HEAD no endereço antigo (a API escrevendo) para com 410, pra nenhuma sessão nascer lá.
# Com regras de rewrite aqui, as da raiz deixam de valer nesta pasta: o https obrigatório da raiz vem repetido (fora do
# 127.0.0.1/localhost dos testes).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?oprojeto\.online$ [NC]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^(.*)$ https://greencheese.oprojeto.online/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^(www\.)?oprojeto\.online$ [NC]
  RewriteRule ^ - [G,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(127\.0\.0\.1|localhost)(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://ipwho.is https://get.geojs.io https://brasilapi.com.br https://viacep.com.br https://docs.google.com https://*.googleusercontent.com; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
  # A raiz tem uma CSP em <FilesMatch "^(index|demo|catalogo)\.html$"> que, por ser seção de arquivo, passaria por
  # cima da regra acima no index.html desta pasta. Uma seção de arquivo aqui (aplicada depois da raiz) devolve a nossa.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://ipwho.is https://get.geojs.io https://brasilapi.com.br https://viacep.com.br https://docs.google.com https://*.googleusercontent.com; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
  </FilesMatch>
  # No subdomínio (11/10), os cabeçalhos de segurança da raiz do domínio não chegam mais nesta pasta: vêm daqui, com os
  # mesmos valores da raiz. O HSTS vai em toda resposta (o navegador só o leva em conta no https; sem includeSubDomains,
  # que é coisa da raiz). Os outros vão nos arquivos estáticos: o PHP da API já manda os dele (gc_cabecalhos) e as
  # pastas uploads/ e produtos/ mandam os delas, que trocam estes sem dobrar.
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(html|webmanifest|js|css|json|png|jpe?g|webp|gif|svg|ico|woff2?|mp4|webm|txt|xml)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  </FilesMatch>
  # HTML sempre revalidado: quem abre no celular vê a versão nova na hora.
  # Os arquivos de assets/ têm o hash no nome, então podem ficar em cache por 1 ano.
  <FilesMatch "\.(html|webmanifest)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # o script do atalho home2/ (ir.js) não tem hash no nome: revalida sempre, como o HTML
  <FilesMatch "^ir\.js$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

AddType text/javascript .js
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
