# Copie para .env e ajuste. Todas as variáveis usam o prefixo IHCHAT_.

# --- básico ---------------------------------------------------------------
# Troque a chave secreta em produção: é ela que assina os tokens de sessão.
IHCHAT_CHAVE_SECRETA=troque-esta-chave-em-producao
IHCHAT_HORAS_TOKEN=12

# SQLite por padrão. Para PostgreSQL:
# IHCHAT_BANCO_URL=postgresql+psycopg://usuario:senha@localhost/ihchat
IHCHAT_BANCO_URL=sqlite:///./ihchat.db

# --- atendimento ----------------------------------------------------------
# Nova mensagem do contato dentro desta janela reabre a conversa resolvida
# em vez de abrir outra.
IHCHAT_HORAS_REABERTURA=24

# Distribui conversas novas para o atendente disponível com a menor fila.
IHCHAT_DISTRIBUICAO_AUTOMATICA=true

# Com o sandbox ligado, um canal sem credenciais registra o envio como
# "simulada" em vez de falhar. Desligue em produção, para que uma credencial
# faltando apareça como erro e não como mensagem silenciosamente não enviada.
IHCHAT_MODO_SANDBOX=true

# --- anexos ---------------------------------------------------------------
# Pasta onde ficam os arquivos das conversas. O download passa sempre pela
# API, nunca por caminho estático, para o arquivo herdar a permissão da
# conversa.
IHCHAT_PASTA_ANEXOS=./anexos
IHCHAT_TAMANHO_MAX_ANEXO_MB=20

# --- coleta de e-mail (IMAP) ---------------------------------------------
IHCHAT_COLETOR_ATIVO=true
IHCHAT_INTERVALO_COLETA=60

# --- rede -----------------------------------------------------------------
IHCHAT_TIMEOUT_HTTP=15
# Origens liberadas para o widget embutido em outros sites.
# IHCHAT_ORIGENS_PERMITIDAS=["https://www.seusite.com.br"]

# Senha do administrador criado pelo scripts/seed.py (só na primeira carga).
IHCHAT_SENHA_ADMIN=admin123
